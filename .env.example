# Copy to .env and fill in values. Never commit .env.
# This file is auto-checked by scripts/generate_env_example.py — keep it in sync with app/core/config.py.

# ============================================================================
# Deployment Environment
# ============================================================================
# One of: dev, staging, prod. In prod a model-validator enforces:
#   QDRANT_USE_MEMORY=false, REDIS_HOST not localhost, DEBUG=false,
#   CACHE_KEY_SALT not the placeholder.
ENVIRONMENT=dev

# ============================================================================
# LLM Provider
# ============================================================================
# Selects which LLM backend the app talks to.
#   "bifrost"            — Tekion's internal LLM Gateway (default for internal use).
#   "openai_compatible"  — any OpenAI-compatible endpoint (Gemini AI Studio,
#                          OpenAI, OpenRouter, vLLM, Ollama, etc.).
LLM_PROVIDER=bifrost

# --- Provider: bifrost (active when LLM_PROVIDER=bifrost) -------------------
# Get your key from #ai-platform-support slack channel.
# Required at startup when LLM_PROVIDER=bifrost; the app will refuse to boot without it.
TEKION_LLM_KEY=your-bifrost-key-here

BIFROST_BASE_URL=https://bifrost.stageapp.tekioncloud.xyz/v1
EMBEDDINGS_BASE_URL=https://bifrost.stageapp.tekioncloud.xyz/v1

# --- Provider: openai_compatible (active when LLM_PROVIDER=openai_compatible)
# Gemini 2.5 Flash via Google AI Studio's OpenAI-compatible endpoint. This is
# the configuration the public Hugging Face Space uses. Get an API key from
# https://aistudio.google.com/apikey
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-google-ai-studio-key
# LLM_MODEL=gemini-2.5-flash

# ============================================================================
# Model Configuration
# ============================================================================
MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOKENS=4096
TEMPERATURE=0.7

# ============================================================================
# Embedding Provider
# ============================================================================
# Options: "huggingface" or "openai"
EMBEDDING_PROVIDER=huggingface

# HuggingFace model (used when EMBEDDING_PROVIDER=huggingface).
# Recommended: BAAI/bge-base-en-v1.5 (768 dim, best quality)
HUGGINGFACE_MODEL=BAAI/bge-base-en-v1.5

# ============================================================================
# Application
# ============================================================================
DEBUG=false
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================================================
# RAG / Qdrant
# ============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=system_design_docs
QDRANT_USE_MEMORY=false
QDRANT_PATH=./data/vector_store/qdrant_data

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

# Advanced RAG performance toggles
ENABLE_MULTI_QUERY_RETRIEVAL=true
MULTI_QUERY_USE_LLM=false
ENABLE_RERANKING=true
ENABLE_HALLUCINATION_GUARD=true
MULTI_QUERY_NUM_SUB_QUERIES=3
MULTI_QUERY_TOP_K_PER_QUERY=3

# ============================================================================
# Redis Cache
# ============================================================================
# Set REDIS_ENABLED=false to run without caching (degraded performance).
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Per-type cache TTLs (seconds)
CACHE_EMBEDDING_TTL=604800
CACHE_LLM_TTL=3600
CACHE_CONVERSATION_TTL=1800

# Per-type cache enable flags
CACHE_EMBEDDINGS=true
CACHE_LLM_RESPONSES=true
CACHE_CONVERSATIONS=true

# Salt used when hashing cache keys (must be at least 16 chars; required).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CACHE_KEY_SALT=replace-with-generated-token-at-least-16-chars

# ============================================================================
# Retry / Timeout
# ============================================================================
LLM_TIMEOUT=60
MAX_RETRIES=3
RETRY_DELAY=1.0

# ============================================================================
# Token usage tracking
# ============================================================================
TRACK_TOKEN_USAGE=true

# ============================================================================
# Evaluation
# ============================================================================
# CONFIDENCE_THRESHOLD: gate on evaluator score before returning a design.
# REFLECTION_CONFIDENCE_THRESHOLD: gate on confidence to trigger a revise pass.
# These are intentionally two different thresholds — do not collapse them.
ENABLE_EVALUATION=false
CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Reflection / Revise loop
# ============================================================================
REFLECTION_ENABLED=true
REFLECTION_CONFIDENCE_THRESHOLD=0.7
MAX_REVISIONS=2

# ============================================================================
# Function-calling / tool-use
# ============================================================================
TOOLS_ENABLED=true
TOOL_MAX_ITERATIONS=4

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=
LOG_REQUESTS=true
LOG_ERRORS=true

# ============================================================================
# Auth + Rate Limiting
# ============================================================================
# Comma-separated list of API keys accepted via the `x-api-key` header.
# Empty + API_AUTH_ENABLED=true + DEBUG=false will refuse to boot.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
API_AUTH_ENABLED=true
# Optional convenience key consumed by the eval harness / CI.
TEST_API_KEY=

# slowapi limits. Format: "<count>/<period>" — e.g. 20/minute, 1000/hour.
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_HEALTH=60/minute

# slowapi storage backend. Use redis://... in prod so multiple workers share
# counters; "memory://" is per-process and only suitable for single-worker dev.
RATE_LIMIT_STORAGE_URI=memory://

# ============================================================================
# Startup Behavior
# ============================================================================
# When Qdrant has zero points at boot, run bootstrap_knowledge() against
# KNOWLEDGE_DATA_DIR. Idempotent (deterministic point IDs), but off by default
# so prod restarts never silently re-ingest.
AUTO_SEED_KNOWLEDGE=false

# When true, any Qdrant init exception aborts the boot. Flip to false on
# laptops without a Qdrant server to run in degraded mode.
QDRANT_REQUIRED_ON_STARTUP=true

# When true, the lifespan probes BIFROST_BASE_URL with a 3s timeout. In prod,
# "down" aborts the boot. Off by default to keep cold starts fast in dev.
BIFROST_HEALTHCHECK_ON_STARTUP=false

# Directory of .md/.txt/.json knowledge files consumed by bootstrap_knowledge().
KNOWLEDGE_DATA_DIR=./data/system_design_docs

# ============================================================================
# Observability
# ============================================================================
# /readyz behavior. By default the readiness probe checks Redis + Qdrant only;
# enable READYZ_CHECK_BIFROST to additionally probe BIFROST_BASE_URL. Toggle
# READYZ_REQUIRE_BIFROST to make Bifrost a required dependency (503 when down).
READYZ_CHECK_BIFROST=false
READYZ_REQUIRE_BIFROST=false

# Prometheus /metrics. Disable to drop the endpoint entirely. When both basic
# auth fields are set, /metrics requires HTTP basic auth (recommended for any
# externally reachable deployment).
METRICS_ENABLED=true
METRICS_BASIC_AUTH_USER=
METRICS_BASIC_AUTH_PASSWORD=

# Sentry (optional, off by default). Set SENTRY_DSN to wire FastAPI integration
# at process start. send_default_pii is always False.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
